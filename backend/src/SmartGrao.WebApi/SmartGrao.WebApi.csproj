<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Emite openapi/v1.json a cada build. O cliente do frontend e gerado pelo Orval a partir
         desse arquivo, entao uma mudanca de contrato aparece no diff do pull request em vez de
         so estourar em tempo de execucao no navegador. -->
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../../openapi</OpenApiDocumentsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartGrao.Application\SmartGrao.Application.csproj" />
    <ProjectReference Include="..\SmartGrao.Infrastructure\SmartGrao.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Serilog.AspNetCore" />
    <!-- Pin transitivo para longe da 2.0.0 vulneravel (NU1903). -->
    <PackageReference Include="Microsoft.OpenApi" />
  </ItemGroup>

</Project>
