{
  "ConnectionStrings": {
    "SmartGrao": ""
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "Analytics": {
    "BaseUrl": "http://localhost:8000/"
  },
  "Vision": {
    "Analyzer": "Service",
    "WorkerEnabled": true
  },
  "Weather": {
    "RefreshIntervalHours": 6
  },
  "AllowedHosts": "*"
}
